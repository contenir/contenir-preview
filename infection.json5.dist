{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            "badge": "/^(main|master)$/"
        }
    },
    "mutators": {
        "@default": true,
        "ReturnRemoval": {
            // A cache that refuses a key counts nothing: put()'s catch ends the method either way,
            // so removing its return changes nothing, and an empty catch is refused by the linter.
            "ignore": ["Contenir\\Preview\\Share\\Throttle\\CacheCounter::put"]
        }
    },
    "staticAnalysisTool": "mago"
}
